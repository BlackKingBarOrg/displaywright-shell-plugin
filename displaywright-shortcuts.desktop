[Desktop Entry]
Type=Application
Name=Displaywright Shortcuts
GenericName=Add a key and a menu row for Displaywright
Comment=Pick a free keybinding and add a Displays row to the Omarchy menu
Exec=omarchy-launch-floating-terminal-with-presentation @SCRIPT@
TryExec=omarchy-shell
Icon=@ICON@
Terminal=false
StartupNotify=false
Categories=Settings;DesktopSettings;
Keywords=displaywright;display;shortcut;shortcuts;keybinding;keybind;hotkey;menu;
X-Displaywright-Managed=true
